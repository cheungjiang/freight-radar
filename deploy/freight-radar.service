[Unit]
Description=Freight intel radar (MCP server + scheduler)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APP_DIR__
Environment=PYTHONUNBUFFERED=1
ExecStart=__APP_DIR__/.venv/bin/python -m radar serve
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
